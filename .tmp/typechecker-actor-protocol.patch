+            actor: Box::new(var("target")),
+            behavior: "ping".to_string(),
+            args: vec![int_lit(1)],
+            remote: false,
+            timeout_ms: None,
+            span: sp(),
+        };
+        let (subst, ty) = tc.infer_expr(&ctx, &ask).expect("typed ask");
+        assert_eq!(apply_subst(&ty, &subst), Type::string());
+
+        let missing = Expr::Send {
+            actor: Box::new(var("target")),
