+    #[test]
+    fn concrete_actor_protocol_is_enforced_without_ast_prepass() {
+        let protocol = Type::Record(vec![(
+            "ping".to_string(),
+            Type::Function {
+                param: Box::new(Type::Tuple(vec![Type::int()])),
+                ret: Box::new(Type::string()),
+                effect: EffectRow::empty(),
