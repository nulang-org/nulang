diff --git a/scripts/check_mobile_runtime_profile.sh b/scripts/check_mobile_runtime_profile.sh
new file mode 100755
--- /dev/null
+++ b/scripts/check_mobile_runtime_profile.sh
@@ -0,0 +1,84 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+FEATURES="mobile-runtime"
+
+echo "==> Checking interpreter-only mobile runtime"
+cargo check --lib --no-default-features --features "$FEATURES"
+
+echo "==> Running library tests for mobile runtime profile"
+cargo test --lib --no-default-features --features "$FEATURES"
+
+echo "==> Auditing runtime dependency graph"
+tree="$(
+  cargo tree \
+    --no-default-features \
+    --features "$FEATURES" \
+    --edges normal,build
+)"
+
+printf '%s\n' "$tree"
+
+forbidden='(^|[[:space:]├└│─])(cranelift([[:alnum:]_-]*)?|wasmtime|libloading)[[:space:]]v'
+if printf '%s\n' "$tree" | grep -Eiq "$forbidden"; then
+  echo >&2
+  echo "ERROR: mobile-runtime dependency graph contains native codegen/dynamic-loader crates:" >&2
+  printf '%s\n' "$tree" | grep -Ei "$forbidden" >&2 || true
+  exit 1
+fi
+
+echo "==> Verifying Cargo feature ownership"
+metadata="$(cargo metadata --format-version 1 --no-deps)"
+python3 - "$metadata" <<'PY'
+import json
+import sys
+
+metadata = json.loads(sys.argv[1])
+root = next(
+    (p for p in metadata["packages"] if p["name"] == "nulang"),
+    None,
+)
+if root is None:
+    raise SystemExit("nulang package missing from cargo metadata")
+
+features = root["features"]
+required_native_deps = {
+    "dep:cranelift",
+    "dep:cranelift-jit",
+    "dep:cranelift-module",
+    "dep:cranelift-native",
+    "dep:cranelift-frontend",
+    "dep:cranelift-codegen",
+    "dep:target-lexicon",
+}
+native = set(features.get("native-codegen", []))
+missing = sorted(required_native_deps - native)
+if missing:
+    raise SystemExit(
+        "native-codegen no longer owns required codegen deps: " + ", ".join(missing)
+    )
+
+mobile = set(features.get("mobile-runtime", []))
+forbidden_mobile = sorted(
+    item for item in mobile
+    if item == "native-codegen"
+    or item == "ffi"
+    or item.startswith("dep:cranelift")
+    or item in {"dep:wasmtime", "dep:libloading"}
+)
+if forbidden_mobile:
+    raise SystemExit(
+        "mobile-runtime directly enables forbidden features/deps: "
+        + ", ".join(forbidden_mobile)
+    )
+
+default = set(features.get("default", []))
+if "native-codegen" not in default:
+    raise SystemExit(
+        "default builds must retain native-codegen until the public default changes intentionally"
+    )
+
+print("mobile-runtime feature ownership: OK")
+PY
+
+echo "mobile-runtime profile: OK"
