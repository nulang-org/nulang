diff --git a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -38,7 +38,26 @@
 [features]
-default = ["python", "sqlite", "lsp", "ai-runtime", "tls", "ffi", "tcp", "ureq"]
+default = ["native-codegen", "python", "sqlite", "lsp", "ai-runtime", "tls", "ffi", "tcp", "ureq"]
+# Cranelift-backed tiered JIT plus the current "AOT" native backend. The
+# current AOT implementation uses cranelift_jit::JITModule internally, so both
+# belong behind one boundary until true object-file AOT is separated.
+native-codegen = [
+    "dep:cranelift",
+    "dep:cranelift-jit",
+    "dep:cranelift-module",
+    "dep:cranelift-native",
+    "dep:cranelift-frontend",
+    "dep:cranelift-codegen",
+    "dep:target-lexicon",
+]
+# Marker profile for the embedded mobile runtime. Intentionally empty:
+# pre-registered native callbacks work without dynamic `libloading`, and the
+# bytecode interpreter/actors/.nbc loader do not require Cranelift.
+mobile-runtime = []
 python = ["dep:pyo3"]
 sqlite = ["dep:libsql"]
 lsp = ["dep:tower-lsp", "dep:tokio", "dep:futures", "dep:tower-service"]
 ai-runtime = ["dep:nulang-ai", "dep:nulang-ai-local", "dep:uuid", "dep:reqwest", "dep:tokio"]
-wasm-backend = ["dep:wasm-encoder", "dep:wasmtime", "dep:wat"]
+# The current WASM SIMD path shares native-codegen analysis types, and Wasmtime
+# itself is configured with its Cranelift backend. Keep that relationship
+# explicit rather than broadening the mobile refactor.
+wasm-backend = ["native-codegen", "dep:wasm-encoder", "dep:wasmtime", "dep:wat"]
diff --git a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -70,2 +70,2 @@
-# Differential fuzzing driver binary (src/bin/nula_difffuzz.rs).
-difffuzz = []
+# Differential fuzzing compares interpreter/JIT/AOT, so it requires native codegen.
+difffuzz = ["native-codegen"]
diff --git a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -91,7 +91,7 @@
-# Cranelift JIT backend
-cranelift = "0.132"
-cranelift-jit = "0.132"
-cranelift-module = "0.132"
-cranelift-native = "0.132"
-cranelift-frontend = "0.132"
-cranelift-codegen = { version = "0.132", features = ["riscv64"] }
+# Cranelift native-codegen backend (optional; excluded from mobile-runtime).
+cranelift = { version = "0.132", optional = true }
+cranelift-jit = { version = "0.132", optional = true }
+cranelift-module = { version = "0.132", optional = true }
+cranelift-native = { version = "0.132", optional = true }
+cranelift-frontend = { version = "0.132", optional = true }
+cranelift-codegen = { version = "0.132", features = ["riscv64"], optional = true }
diff --git a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1 +1 @@
-target-lexicon = "0.13"
+target-lexicon = { version = "0.13", optional = true }
