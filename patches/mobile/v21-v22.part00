             aot_targets: Vec::new(),
             bytecode_offsets: Vec::new(),
diff --git a/src/runtime/actor.rs b/src/runtime/actor.rs
--- a/src/runtime/actor.rs
+++ b/src/runtime/actor.rs
@@ -300,3 +300,3 @@
             priority: ActorPriority::Normal,
-            jit_safepoint_counter: crate::jit::runtime::JIT_SAFEPOINT_BUDGET,
+            jit_safepoint_counter: crate::backends::JIT_SAFEPOINT_BUDGET,
             jit_yield_pending: false,
diff --git a/src/runtime/mod.rs b/src/runtime/mod.rs
--- a/src/runtime/mod.rs
+++ b/src/runtime/mod.rs
@@ -430,7 +430,6 @@
-    /// AOT-compiled modules registered for native behavior dispatch, keyed by
-    /// actor type name → module pointer. Ownership lives in
-    /// `aot_module_storage`; the pointers are stable (each module is Boxed).
+    /// AOT-compiled modules registered for native behavior dispatch.
+    #[cfg(feature = "native-codegen")]
     pub aot_modules: std::collections::HashMap<String, *const crate::aot::AotModule