// Nulang web framework — semantic types.
// Import: `import stdlib::web::types`
//
// Web semantic types erase to simple runtime representations. Most are
// opaque distinctions enforced by the typechecker; Json[T] is a transparent
// serialized-body marker whose T parameter carries response-schema metadata
// for Web Contract IR, OpenAPI, deployment adapters, and Nulang Cloud.

/// Serialized JSON response body. T documents the logical payload schema.
/// The runtime representation is an already-serialized String; automatic
/// serialization is intentionally a later layer rather than implicit magic.
pub type alias Json[T] = String

/// Escaped HTML document fragment. Distinct from String at compile time.
opaque type Html = String

/// Trusted raw HTML that bypasses automatic escaping. Distinct from String.
opaque type RawHtml = String

/// Email address (validation is a framework concern, not the type itself).
opaque type Email = String

/// Absolute or relative URL.
opaque type Url = String

/// CSS class name string.
opaque type CssClass = String

/// A path parameter captured from a route.
opaque type RouteParam = String
