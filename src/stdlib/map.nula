// Nulang standard library — Map operations.
// Language version: 2.0.0-alpha
// Import: `import stdlib::map`
//
// Maps are arrays of {key, value} records.
// Key lookup is O(n). get() returns Option[value] so absence is explicit.

/// An empty map.
pub fn empty() { [] }

/// Insert or update a key-value pair. Returns a new map.
pub fn insert(k, v, m) {
    var found = false;
    var result = [];
    for r in m {
        if r.key == k then {
            result = perform Array.push(result, {key: k, value: v});
            found = true
        } else {
            result = perform Array.push(result, r)
        }
    };
    if found then result else { perform Array.push(result, {key: k, value: v}) }
}

/// Look up a key. Returns Some(value) when present, otherwise None.
pub fn get(k, m) {
    for r in m {
        if r.key == k then { return Some(r.value) } else {}
    };
    None
}

/// True when the key is present.
pub fn contains_key(k, m) {
    for r in m {
        if r.key == k then { return true } else {}
    };
    false
}

/// Remove a key. Returns a new map.
pub fn remove(k, m) {
    var result = [];
    for r in m {
        if r.key != k then { result = perform Array.push(result, r) } else {}
    };
    result
}

/// Number of key-value pairs.
pub fn size(m) { perform Array.length(m) }

/// True when the map is empty.
pub fn is_empty(m) { perform Array.length(m) == 0 }

/// Return an array of all keys.
pub fn keys(m) {
    var result = [];
    for r in m {
        result = perform Array.push(result, r.key)
    };
    result
}

/// Return an array of all values.
pub fn values(m) {
    var result = [];
    for r in m {
        result = perform Array.push(result, r.value)
    };
    result
}

/// Convert a list of (key, value) tuples into a value-style map.
/// Duplicate keys use the last supplied value, keeping the first key position.
/// Construction is O(n^2) for n distinct keys with this array-backed format.
pub fn from_pairs(entries) {
    var result = empty();
    for entry in entries {
        result = insert(entry.0, entry.1, result)
    };
    result
}

/// Return a list of (key, value) tuples in insertion order.
/// Each result is a fresh array; this map uses no mutable hash-table storage.
pub fn to_pairs(m) {
    var result = [];
    for entry in m {
        result = perform Array.push(result, (entry.key, entry.value))
    };
    result
}

/// Merge two value-style maps without changing either input.
/// Keys from right replace keys in left; all other entries are retained.
/// Complexity is O((n + m) * (n + m)) in the worst case, not a hash-map merge.
pub fn merge(left, right) {
    var result = left;
    for entry in right {
        result = insert(entry.key, entry.value, result)
    };
    result
}

/// Return the mapped value, or a provided fallback if the key is absent.
/// Unlike the VM's mutable Map effect, the value-style get returns Option.
pub fn get_or(k, m, fallback) {
    match get(k, m) {
        Some(value) => value,
        None => fallback,
    }
}
