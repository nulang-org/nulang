// Nulang standard library — String operations.
// Language version: 2.0.0-alpha
// Import: `import stdlib::string`
//
// Built on primitives: String.length, String.charAt (→ Int code),
// String.substring(s, start, length), String.concat(s1, s2), and the
// amortized-linear StrBuilder primitives for repeated text assembly.
//
// NOTE: `a + b` where both operands are non-literal strings returns 0
// (VM bug). Use `perform String.concat(a, b)` for one-off variable-to-variable
// concatenation and StrBuilder for loops that append repeatedly.

/// Length of the string in bytes.
pub fn length(s) { perform String.length(s) }

/// True when the string is empty.
pub fn is_empty(s) { perform String.length(s) == 0 }

/// Character at index i, returned as a 1-character string.
/// Returns "" if i is out of bounds.
pub fn char_at(s, i) {
    let len = perform String.length(s);
    if i >= 0 && i < len then { return perform String.substring(s, i, 1) } else { return "" }
}

/// Character code at index i, or -1 if out of bounds.
pub fn char_code_at(s, i) {
    let len = perform String.length(s);
    if i >= 0 && i < len then { return perform String.charAt(s, i) } else { return -1 }
}

// ── Substring search ──────────────────────────────────────────────────────

/// True when s starts with prefix.
pub fn starts_with(s, prefix) {
    let plen = perform String.length(prefix);
    if plen > perform String.length(s) then { return false } else {};
    perform String.substring(s, 0, plen) == prefix
}

/// True when s ends with suffix.
pub fn ends_with(s, suffix) {
    let sulen = perform String.length(suffix);
    let slen = perform String.length(s);
    if sulen > slen then { return false } else {};
    perform String.substring(s, slen - sulen, sulen) == suffix
}

/// True when s contains the substring needle.
/// Reuse the allocation-free byte comparison in index_of instead of
/// materializing a candidate substring at every position.
pub fn contains(s, needle) {
    index_of(s, needle) >= 0
}

/// First index of substring ch in s, or -1 if not found.
pub fn index_of(s, ch) {
    let slen = perform String.length(s);
    let chlen = perform String.length(ch);
    if chlen == 0 then { return 0 } else {};
    var i = 0;
    while i + chlen <= slen {
        var found = true;
        var j = 0;
        while j < chlen && found {
            if perform String.charAt(s, i + j) != perform String.charAt(ch, j) then { found = false } else {};
            j = j + 1
        };
        if found then { return i } else {};
        i = i + 1
    };
    -1
}

// ── Building and repeating ────────────────────────────────────────────────

/// Repeat string s n times.
/// Uses StrBuilder so repeated append is amortized linear in the output size.
pub fn repeat(s, n) {
    var b = perform StrBuilder.new();
    var i = 0;
    while i < n {
        b = perform StrBuilder.push(b, s);
        i = i + 1
    };
    perform StrBuilder.to_string(b)
}

/// Reverse the string.
pub fn reverse(s: String) -> String {
    var b = perform StrBuilder.new();
    var i = perform String.length(s) - 1;
    while i >= 0 {
        let code = perform String.charAt(s, i);
        b = perform StrBuilder.push(b, perform String.from_char(code));
        i = i - 1
    };
    perform StrBuilder.to_string(b)
}

// ── Whitespace trimming ───────────────────────────────────────────────────

/// Remove leading and trailing whitespace (spaces, tabs, newlines, CR).
pub fn trim(s) {
    let len = perform String.length(s);

    // Recursive helper to find first non-whitespace index.
    let rec find_start = fn(i) {
        if i >= len then i
        else {
            let c = perform String.charAt(s, i);
            if c == 32 || c == 9 || c == 10 || c == 13 then find_start(i + 1)
            else i
        }
    };

    // Recursive helper to find one-past-last non-whitespace index.
    let rec find_end = fn(i) {
        if i <= 0 then 0
        else {
            let c = perform String.charAt(s, i - 1);
            if c == 32 || c == 9 || c == 10 || c == 13 then find_end(i - 1)
            else i
        }
    };

    let start_idx = find_start(0);
    let end_idx = find_end(len);
    if start_idx >= end_idx then ""
    else perform String.substring(s, start_idx, end_idx - start_idx)
}

// ── Split and join ────────────────────────────────────────────────────────

/// Split string s by a delimiter character (a 1-char string).
/// Returns an array of substrings.
pub fn split(s, delim) {
    var result = [];
    var current = perform StrBuilder.new();
    var i = 0;
    let len = perform String.length(s);
    let dcode = perform String.charAt(delim, 0);
    while i < len {
        let c = perform String.charAt(s, i);
        if c == dcode then {
            result = perform Array.push(result, perform StrBuilder.to_string(current));
            current = perform StrBuilder.reset(current)
        } else {
            current = perform StrBuilder.push(current, perform String.substring(s, i, 1))
        };
        i = i + 1
    };
    perform Array.push(result, perform StrBuilder.to_string(current))
}

/// Join an array of strings with a separator string.
pub fn join(parts, sep) {
    var b = perform StrBuilder.new();
    var i = 0;
    let len = perform Array.length(parts);
    while i < len {
        if i > 0 then { b = perform StrBuilder.push(b, sep) } else {};
        b = perform StrBuilder.push(b, parts[i]);
        i = i + 1
    };
    perform StrBuilder.to_string(b)
}

// ── Replace ───────────────────────────────────────────────────────────────

/// Replace all occurrences of substring `from` with `to` in s.
pub fn replace(s, from, to) {
    var b = perform StrBuilder.new();
    var i = 0;
    let slen = perform String.length(s);
    let flen = perform String.length(from);
    while i < slen {
        var found_match = flen > 0 && i + flen <= slen;
        var j = 0;
        while j < flen && found_match {
            if perform String.charAt(s, i + j) != perform String.charAt(from, j) then { found_match = false } else {};
            j = j + 1
        };
        if found_match then {
            b = perform StrBuilder.push(b, to);
            i = i + flen
        } else {
            b = perform StrBuilder.push(b, perform String.substring(s, i, 1));
            i = i + 1
        }
    };
    perform StrBuilder.to_string(b)
}

// ── Case conversion ───────────────────────────────────────────────────────

/// Convert string to lowercase (ASCII only, non-ASCII passthrough).
pub fn to_lower(s: String) -> String {
    var b = perform StrBuilder.new();
    var i = 0;
    let len = perform String.length(s);
    while i < len {
        let c = perform String.charAt(s, i);
        if c >= 65 && c <= 90 then {
            b = perform StrBuilder.push(b, perform String.from_char(c + 32))
        } else {
            b = perform StrBuilder.push(b, perform String.from_char(c))
        };
        i = i + 1
    };
    perform StrBuilder.to_string(b)
}

/// Convert string to uppercase (ASCII only, non-ASCII passthrough).
pub fn to_upper(s: String) -> String {
    var b = perform StrBuilder.new();
    var i = 0;
    let len = perform String.length(s);
    while i < len {
        let c = perform String.charAt(s, i);
        if c >= 97 && c <= 122 then {
            b = perform StrBuilder.push(b, perform String.from_char(c - 32))
        } else {
            b = perform StrBuilder.push(b, perform String.from_char(c))
        };
        i = i + 1
    };
    perform StrBuilder.to_string(b)
}

/// True when no alphabetic character in the string is lowercase.
pub fn is_upper(s: String) -> Bool {
    var i = 0;
    let len = perform String.length(s);
    while i < len {
        let c = perform String.charAt(s, i);
        if c >= 97 && c <= 122 then { return false } else {};
        i = i + 1
    };
    true
}

/// True when no alphabetic character in the string is uppercase.
pub fn is_lower(s: String) -> Bool {
    var i = 0;
    let len = perform String.length(s);
    while i < len {
        let c = perform String.charAt(s, i);
        if c >= 65 && c <= 90 then { return false } else {};
        i = i + 1
    };
    true
}

// ── String builder (amortized O(n) text assembly) ─────────────────────────
//
// The StrBuilder effect provides a mutable growable buffer. Appending is
// amortized O(1) with capacity doubling, unlike `String.concat` which is
// O(n) per call. The builder is mutable: rebind the returned value
// (`b = perform StrBuilder.push(b, s)`), since growth may return a new
// pointer.

/// Create an empty string builder.
pub fn builder() { perform StrBuilder.new() }

/// Append a string to the builder (amortized O(1)).
pub fn builder_push(b, s) { perform StrBuilder.push(b, s) }

/// Materialize the builder contents as an immutable string.
pub fn builder_to_string(b) { perform StrBuilder.to_string(b) }

/// Number of bytes currently in the builder.
pub fn builder_len(b) { perform StrBuilder.len(b) }

/// Clear the builder (capacity retained).
pub fn builder_reset(b) { perform StrBuilder.reset(b) }

/// Build a string by applying `f` to a fresh builder and materializing.
/// `f` receives the builder and returns the (possibly grown) builder.
pub fn build(f) {
    var b = perform StrBuilder.new();
    b = f(b);
    perform StrBuilder.to_string(b)
}
