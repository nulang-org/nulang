-/// Opcodes the typed compiler knows how to emit.
+/// Opcodes the typed compiler knows how to emit soundly.
 ///
 /// This is deliberately a subset of `compiler::is_opcode_compilable`: the
 /// typed compiler's catch-all arm jumps to the return block, so an
 /// unsupported opcode in the middle of a region would silently drop the
 /// remaining instructions. Callers must pre-check regions with this
 /// function (as `compile_bytecode_region_typed` does) and fall back to the
 /// scalar compiler for anything outside the set.
+///
+/// Control flow is intentionally excluded for now. `infer_reg_types` performs
+/// a proper per-PC CFG fixpoint, but `compile_bytecode_region_typed` receives
+/// only the entry-point `TypeMetadata` and then mutates one metadata object in
+/// linear bytecode order while emitting branches/backedges. Those linearly
+/// evolved facts are not sound at join points or on later loop iterations.
+/// Until codegen consumes per-PC metadata, any region containing a jump must
+/// use the scalar JIT, whose runtime helpers preserve the interpreter's tagged
+/// semantics. This is a correctness fallback, not a permanent optimization
+/// limitation.
 pub fn is_opcode_supported_typed(op: OpCode) -> bool {
@@
