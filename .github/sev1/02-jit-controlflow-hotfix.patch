+            // cold=964593, warm=0 when a loop-carried var update was lost.
+            r#"let i2 = { var fa0 = 0
+for x1 in [964593] { fa0 = fa0 + x1 }
+fa0 }
+i2"#,
+            // Straightforward loop-carried floating state. This also guards
+            // against reintroducing unsound type facts on a backedge.
+            "var i = 0.0; var s = 0.0; while i < 100.0 { s = s + i * 2.5; i = i + 1.0; }; s",
+        ];
+
+        for source in cases {
