// Polymorphic collection operations must not require Int elements.
// Int-only callers remain covered by stdlib_04 and stdlib_08.
import stdlib::list

fn main() {
    let colors = append(["red"], ["blue"])
    perform IO.print("append=" + colors[0] + "," + colors[1])

    let pairs = zip(["alice", "bob"], [10, 20])
    let first = pairs[0]
    let second = pairs[1]
    let first_number = perform Int.to_string(first.1)
    let second_number = perform Int.to_string(second.1)
    perform IO.print("zip=" + first.0 + ":" + first_number + "," + second.0 + ":" + second_number)

    let indexed = enumerate(["north", "south"])
    let second_indexed = indexed[1]
    perform IO.print("enumerate=" + perform Int.to_string(second_indexed.0) + ":" + second_indexed.1)

    let joined = fold(fn(acc, item) { acc + item }, "start", ["-a", "-b"])
    perform IO.print("fold_string=" + joined)

    let counted = fold(fn(acc, item) { acc + 1 }, 0, ["alpha", "beta", "gamma"])
    perform IO.print("fold_cross=" + perform Int.to_string(counted))

    let seed = fold(fn(acc, item) { acc + item }, "seed", [])
    perform IO.print("fold_empty=" + seed)

    let remaining = fold(fn(acc, item) { acc - item }, 20, [2, 3])
    perform IO.print("fold_order=" + perform Int.to_string(remaining))
}
