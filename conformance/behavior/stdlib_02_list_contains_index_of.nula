// stdlib::list — contains and index_of.
// NOTE: argument order is (element, array) — the reverse of SPEC2.md 14.3's
// `List.contains(numbers, 3)`; SPEC's order is a type error.
import stdlib::list

fn main() {
    let xs = [1, 2, 3, 4, 5]
    let b2i = fn(b) { if b then 1 else 0 }
    let show = fn(opt) {
        match opt {
            Some(x) => perform Int.to_string(x),
            None => "None",
        }
    }
    perform IO.print("contains3=" + perform Int.to_string(b2i(contains(3, xs))))
    perform IO.print("contains9=" + perform Int.to_string(b2i(contains(9, xs))))
    perform IO.print("contains_empty=" + perform Int.to_string(b2i(contains(1, []))))
    perform IO.print("idx2=" + show(index_of(2, xs)))
    perform IO.print("idx_first=" + show(index_of(1, xs)))
    perform IO.print("idx_miss=" + show(index_of(99, xs)))
}
