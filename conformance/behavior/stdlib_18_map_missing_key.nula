// stdlib::map — get on a missing key returns None.
// The Option contract preserves the map value type and makes absence explicit.
import stdlib::map

fn main() {
    let show = fn(opt: Option[String]) {
        match opt {
            Some(x) => x,
            None => "None",
        }
    }
    let m = insert("a", "hello", insert("b", "world", []))
    perform IO.print(show(get("a", m)))
    perform IO.print(show(get("z", m)))
}
