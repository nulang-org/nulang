// Returning the nested alias-bound callback cannot inherit a pure outer cb row.
fn good() -> Unit ! {} {}
fn danger() -> Unit ! {IO} { perform IO.print("must not run") }
fn invoke(cb: () -> Unit ! {}, unsafe_cb: () -> Unit ! {IO}) -> Unit ! {} {
    (match (unsafe_cb, 1) with {
        | pair @ (cb, _) => cb
    })()
}
invoke(good, danger)
