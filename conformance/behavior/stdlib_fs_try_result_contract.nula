// New try_* wrappers report Result, while existing FS wrappers stay source-compatible.
import stdlib::fs

fn main() {
    let path = "/tmp/nulang_try_io_results_20261012.txt";
    match try_write(path, "hello") {
        Ok(_) => perform IO.print("write=ok"),
        Error(_) => perform IO.print("write=error"),
    }
    match try_read(path) {
        Ok(value) => perform IO.print("read=" + value),
        Error(_) => perform IO.print("read=error"),
    }
    match try_append(path, "!") {
        Ok(_) => perform IO.print("append=ok"),
        Error(_) => perform IO.print("append=error"),
    }
    match try_read(path) {
        Ok(value) => perform IO.print("read2=" + value),
        Error(_) => perform IO.print("read2=error"),
    }
    match try_read("/tmp/nulang_try_io_results_missing_directory_20261012/file") {
        Ok(_) => perform IO.print("missing=ok"),
        Error(ReadFailed(_)) => perform IO.print("missing=error"),
        Error(_) => perform IO.print("missing=wrong_error"),
    }
    let legacy = read(path);
    perform IO.print("legacy=" + legacy)
    // An empty successful read is distinct from the nil error sentinel.
    match try_write(path, "") {
        Ok(_) => perform IO.print("write_empty=ok"),
        Error(_) => perform IO.print("write_empty=error"),
    }
    match try_read(path) {
        Ok(value) => perform IO.print("read_empty_len=" + perform Int.to_string(perform String.length(value))),
        Error(_) => perform IO.print("read_empty_len=error"),
    }
    // A missing parent must fail for both mutating operations.
    let invalid_path = "/tmp/nulang_try_io_missing_parent_20261012/file";
    match try_write(invalid_path, "x") {
        Error(WriteFailed(_)) => perform IO.print("write_fail=error"),
        _ => perform IO.print("write_fail=wrong"),
    }
    match try_append(invalid_path, "x") {
        Error(AppendFailed(_)) => perform IO.print("append_fail=error"),
        _ => perform IO.print("append_fail=wrong"),
    }

}
