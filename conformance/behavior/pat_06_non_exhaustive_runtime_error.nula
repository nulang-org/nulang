// Closed variant matches emit W0201 in v1.x but remain valid by default.
// If an omitted constructor reaches the match at runtime, the existing
// non-exhaustive-match failure semantics are unchanged.
type Color = Red | Green | Blue

fn name(c: Color) -> String {
    match c {
        | Red => "red"
        | Green => "green"
    }
}

perform IO.print(name(Blue))
