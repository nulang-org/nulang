// Experimental source-level correlated one-shot replies.
// Acceptance means local admission, not necessarily handler execution.
actor Collector {
    behavior open() { perform Actor.reply_open(60000) }
    behavior cancel(reference: Int) { perform Actor.reply_cancel(reference) }
    behavior reply(reference: Int, value: Int) { 0 }
}

actor Sender {
    behavior send_twice(reference: Int) {
        let first = perform Actor.reply_send(reference, 42)
        let second = perform Actor.reply_send(reference, 99)
        perform IO.print(perform Int.to_string(first))
        perform IO.print(perform Int.to_string(second))
        0
    }
    behavior send_late(reference: Int) {
        let status = perform Actor.reply_send(reference, 100)
        perform IO.print(perform Int.to_string(status))
        0
    }
}

fn main() {
    let collector = spawn Collector {}
    let sender = spawn Sender {}
    let reference = ask collector open()
    let _first = ask sender send_twice(reference)
    let canceled_reference = ask collector open()
    let canceled = ask collector cancel(canceled_reference)
    if canceled then {
        perform IO.print("canceled")
    } else {
        perform IO.print("unexpected")
    }
    let _late = ask sender send_late(canceled_reference)
}
