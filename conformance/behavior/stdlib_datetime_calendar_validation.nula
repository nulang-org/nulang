// Gregorian calendar validation: leap days, month lengths, and field bounds.
// The pre-fix is_valid implementation incorrectly accepts Feb 29 in 1900,
// Feb 29 in non-leap years, and the 31st day of 30-day months.
import stdlib::datetime

fn show(dt: DateTime) -> String {
    if is_valid(dt) then "true" else "false"
}

fn main() {
    perform IO.print(show(new(2024, 2, 29, 23, 59, 59)))
    perform IO.print(show(new(2023, 2, 29, 0, 0, 0)))
    perform IO.print(show(new(1900, 2, 29, 0, 0, 0)))
    perform IO.print(show(new(2000, 2, 29, 0, 0, 0)))
    perform IO.print(show(new(2024, 4, 31, 0, 0, 0)))
    perform IO.print(show(new(2024, 6, 30, 0, 0, 0)))
    perform IO.print(show(new(2024, 12, 31, 0, 0, 0)))
    perform IO.print(show(new(2024, 2, 30, 0, 0, 0)))
    perform IO.print(show(new(2024, 0, 10, 0, 0, 0)))
    perform IO.print(show(new(2024, 13, 10, 0, 0, 0)))
    perform IO.print(show(new(2024, 1, 0, 0, 0, 0)))
    perform IO.print(show(new(-1, 1, 1, 0, 0, 0)))
    perform IO.print(show(new(2024, 1, 1, 24, 0, 0)))
    perform IO.print(show(new(2024, 1, 1, 0, 60, 0)))
    perform IO.print(show(new(2024, 1, 1, 0, 0, 60)))
}
