// Historical test id: corrected semantics require emit NOT to mutate unrelated event-sourced fields.\nentity Counter {
    state count: Int = 0
    state other: Int = 100
    events
        | Incremented(by: Int)
    apply
        | Incremented(by) => self.count = self.count + by
    behavior increment(by: Int) { emit Incremented(by) }
    behavior get_other() { self.other }
}
fn main() {
    let c = spawn Counter {} in {
        send c increment(5)
        perform IO.print(ask c get_other())
    }
}
