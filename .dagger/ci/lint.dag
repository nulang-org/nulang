#!/usr/bin/env dagger

# Portable equivalent of the format/clippy/audit/docs CI job.
# Run locally with: dagger .dagger/ci/lint.dag

src=$(host | directory . --exclude .git --exclude target --exclude test-pkg)

container |
  from rust:bookworm |
  with-exec -- apt-get update |
  with-exec -- apt-get install -y --no-install-recommends python3-dev pkg-config libssl-dev ca-certificates |
  with-mounted-cache /usr/local/cargo/registry nulang-cargo-registry |
  with-mounted-cache /usr/local/cargo/git nulang-cargo-git |
  with-exec -- rustup component add rustfmt clippy |
  with-exec -- cargo install cargo-audit --locked |
  with-directory /src $src |
  with-workdir /src |
  with-mounted-cache /tmp/cargo-target nulang-cargo-target-lint |
  with-exec -- cargo fmt --check |
  with-exec -- cargo clippy --all-targets -- -D clippy::correctness |
  with-exec -- cargo clippy --all-targets --all-features -- -D clippy::correctness |
  with-exec -- cargo clippy --all-targets --no-default-features -- -D clippy::correctness |
  with-exec -- cargo check --tests |
  with-exec -- cargo audit |
  with-exec -- cargo check --all-features |
  with-exec -- cargo doc --no-deps |
  with-exec -- bash -c 'RUSTDOCFLAGS="-D warnings" cargo doc --no-deps 2>&1 || true' |
  sync
