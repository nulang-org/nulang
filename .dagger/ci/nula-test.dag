#!/usr/bin/env dagger

# Portable equivalent of the Nula Package Test GitHub Actions job.
# Run locally with: dagger .dagger/ci/nula-test.dag

src=$(host | directory . --exclude .git --exclude target --exclude test-pkg)

container |
  from rust:bookworm |
  with-exec -- apt-get update |
  with-exec -- apt-get install -y --no-install-recommends python3-dev pkg-config libssl-dev ca-certificates |
  with-mounted-cache /usr/local/cargo/registry nulang-cargo-registry |
  with-mounted-cache /usr/local/cargo/git nulang-cargo-git |
  with-directory /src $src |
  with-workdir /src |
  with-env-variable CARGO_TARGET_DIR /src/target |
  with-mounted-cache /src/target nulang-nula-target |
  with-exec -- cargo build --release --bin nulang |
  with-exec -- /src/target/release/nulang --eval 'perform IO.print("hello")' |
  with-exec -- /src/target/release/nulang nula new test-pkg |
  with-exec -- bash -lc 'cd test-pkg && ../target/release/nulang nula test' |
  with-exec -- bash -lc 'NULANG_BIN=/src/target/release/nulang bash scripts/verify_doc_examples.sh' |
  sync
