#!/usr/bin/env dagger

# Portable equivalent of the Build & Test GitHub Actions job.
# Run locally with: dagger .dagger/ci/build-test.dag
#
# Major stages capture verbose Cargo output and print a bounded tail only on
# failure. This keeps CI diagnostics readable without changing gate semantics.

src=$(host | directory . --exclude .git --exclude target --exclude test-pkg)

container |
  from rust:bookworm |
  with-exec -- apt-get update |
  with-exec -- apt-get install -y --no-install-recommends python3-dev pkg-config libssl-dev ca-certificates |
  with-mounted-cache /usr/local/cargo/registry nulang-cargo-registry |
  with-mounted-cache /usr/local/cargo/git nulang-cargo-git |
  with-exec -- cargo install cargo-llvm-cov --locked |
  with-directory /src $src |
  with-workdir /src |
  with-mounted-cache /tmp/cargo-target nulang-cargo-target |
  with-exec -- bash -lc 'log=$(mktemp); if cargo build --all-targets >"$log" 2>&1; then echo "=== STAGE PASSED: build ==="; else rc=$?; echo "=== STAGE FAILED: build ==="; tail -n 160 "$log"; exit "$rc"; fi' |
  with-exec -- bash -lc 'first=$(mktemp); if cargo test >"$first" 2>&1; then echo "=== STAGE PASSED: test ==="; else echo "=== STAGE RETRY: test ==="; tail -n 80 "$first"; second=$(mktemp); if cargo test >"$second" 2>&1; then echo "=== STAGE PASSED: test (retry) ==="; else rc=$?; echo "=== STAGE FAILED: test (retry) ==="; tail -n 160 "$second"; exit "$rc"; fi; fi' |
  with-exec -- bash -lc 'log=$(mktemp); if cargo llvm-cov --all-features --lcov --output-path /src/lcov.info >"$log" 2>&1; then echo "=== STAGE PASSED: coverage ==="; else rc=$?; echo "=== STAGE FAILED: coverage ==="; tail -n 160 "$log"; exit "$rc"; fi' |
  with-exec -- bash -lc 'log=$(mktemp); if python3 scripts/verify_implementation.py >"$log" 2>&1; then echo "=== STAGE PASSED: implementation gate ==="; else rc=$?; echo "=== STAGE FAILED: implementation gate ==="; tail -n 200 "$log"; exit "$rc"; fi' |
  file /src/lcov.info |
  export ./lcov.info
