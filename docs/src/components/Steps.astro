---
const steps = [
	{
		step: '01',
		title: 'Clone',
		description: 'Get the compiler and runtime source.',
		command: 'git clone https://github.com/nulang-org/nulang',
	},
	{
		step: '02',
		title: 'Build',
		description: 'Compile the release binary.',
		command: 'cargo build --release',
	},
	{
		step: '03',
		title: 'Run',
		description: 'Start the REPL or execute a .nula file.',
		command: 'cargo run -- --repl',
	},
];
---

<div class="steps-flow" aria-label="Install Nulang in three steps">
	{steps.map((step) => (
		<div class="step">
			<div class="step-index">{step.step}</div>
			<div class="step-copy">
				<div class="step-heading">
					<strong>{step.title}</strong>
					<span>{step.description}</span>
				</div>
				<code>{step.command}</code>
			</div>
		</div>
	))}
</div>

<style>
	.steps-flow {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid var(--nu-border);
		border-bottom: 1px solid var(--nu-border);
	}

	.step {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.9rem;
		padding: 1.4rem 1.25rem;
	}

	.step + .step {
		border-left: 1px solid var(--nu-border);
	}

	.step-index {
		color: var(--nu-blue);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.76rem;
		font-weight: 800;
	}

	.step-copy {
		min-width: 0;
	}

	.step-heading {
		display: grid;
		gap: 0.15rem;
	}

	.step-heading strong {
		color: var(--nu-text);
		font-size: 0.95rem;
	}

	.step-heading span {
		color: var(--nu-text-secondary);
		font-size: 0.8rem;
		line-height: 1.45;
	}

	.step code {
		display: block;
		margin-top: 0.75rem;
		overflow-x: auto;
		padding: 0;
		background: transparent;
		color: var(--nu-text);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.72rem;
		white-space: nowrap;
	}

	@media (max-width: 48rem) {
		.steps-flow {
			grid-template-columns: 1fr;
		}

		.step + .step {
			border-left: 0;
			border-top: 1px solid var(--nu-border);
		}
	}
</style>
