---
const steps = [
	{
		step: '01',
		title: 'Try online',
		description: 'Run Nulang Core in your browser, no toolchain required.',
		command: 'nulang.org/playground/',
		href: '/playground/',
	},
	{
		step: '02',
		title: 'Install locally',
		description: 'Download a checksummed binary for your platform.',
		command: 'Install a tagged release',
		href: '/getting-started/installation/',
	},
	{
		step: '03',
		title: 'Run your code',
		description: 'Use the installed compiler for the full native runtime.',
		command: 'nulang --repl',
		href: '/getting-started/quick-start/',
	},
];
---

<div class="steps-flow" aria-label="Three ways to begin using Nulang">
	{steps.map((step) => (
		<div class="step">
			<div class="step-index">{step.step}</div>
			<div class="step-copy">
				<div class="step-heading">
					<strong>{step.title}</strong>
					<span>{step.description}</span>
				</div>
				<a class="step-command" href={step.href}>{step.command}</a>
			</div>
		</div>
	))}
</div>

<style>
	.steps-flow {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid var(--nu-border);
		border-bottom: 1px solid var(--nu-border);
	}

	.step {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.9rem;
		padding: 1.4rem 1.25rem;
	}

	.step + .step {
		border-left: 1px solid var(--nu-border);
	}

	.step-index {
		color: var(--nu-blue);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.76rem;
		font-weight: 800;
	}

	.step-copy {
		min-width: 0;
	}

	.step-heading {
		display: grid;
		gap: 0.15rem;
	}

	.step-heading strong {
		color: var(--nu-text);
		font-size: 0.95rem;
	}

	.step-heading span {
		color: var(--nu-text-secondary);
		font-size: 0.8rem;
		line-height: 1.45;
	}

	.step-command {
		display: block;
		margin-top: 0.75rem;
		overflow-x: auto;
		padding: 0;
		background: transparent;
		color: var(--nu-text);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.72rem;
		white-space: nowrap;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 48rem) {
		.steps-flow {
			grid-template-columns: 1fr;
		}

		.step + .step {
			border-left: 0;
			border-top: 1px solid var(--nu-border);
		}
	}
</style>
