---
// CopyMarkdown.astro — Copy Markdown button for doc pages, floats to the right
---

<button id="copy-markdown-btn" class="copy-markdown-btn" type="button">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
  </svg>
  <span id="copy-markdown-label">Copy Markdown</span>
</button>
<span id="copy-markdown-status" class="sr-only" role="status" aria-live="polite"></span>


<style>
  .copy-markdown-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    background: var(--sl-color-bg-inline-code);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    cursor: pointer;
    float: right;
    margin: 0 0 1rem 1.5rem;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .copy-markdown-btn:hover {
    background: var(--sl-color-accent);
    color: #ffffff;
    border-color: var(--sl-color-accent);
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.25);
  }
  .copy-markdown-btn.copied {
    background: var(--nu-orange);
    color: #ffffff;
    border-color: var(--nu-orange);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const button = document.getElementById('copy-markdown-btn');
  const label = document.getElementById('copy-markdown-label');
  const status = document.getElementById('copy-markdown-status');
  if (button && label instanceof HTMLElement && status instanceof HTMLElement) {
    button.addEventListener('click', async () => {
      try {
        const path = location.pathname.replace(/\/$/, '') + '.md';
        const res = await fetch(path);
        if (!res.ok) throw new Error(`fetch failed: ${res.status}`);
        await navigator.clipboard.writeText(await res.text());
        button.classList.add('copied');
        label.textContent = 'Copied!';
        status.textContent = 'Copied!';
        setTimeout(() => {
          button.classList.remove('copied');
          label.textContent = 'Copy Markdown';
          status.textContent = '';
        }, 2000);
      } catch {
        // Clipboard/fetch unavailable — surface it to screen readers.
        status.textContent = 'Copy failed';
      }
    });
  }
</script>
