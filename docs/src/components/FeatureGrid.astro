---
// Dense capability matrix for the homepage. Stable surfaces use the core blue
// identity; experimental surfaces use the secondary orange accent.
const features = [
	{
		id: 'actors',
		title: 'Actor Runtime',
		status: 'Stable core · experimental multi-node',
		icon: '<circle cx="12" cy="12" r="2"/><path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"/>',
		body: 'Spawn, links, monitors, supervision, and actor messaging are stable language surfaces. Multi-node transport and gossip clustering are experimental; source-level CRDT state integration is still incomplete.',
	},
	{
		id: 'effects',
		title: 'Algebraic Effects',
		status: 'Stable',
		icon: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
		body: 'Koka-inspired row-polymorphic effects with compile-time checking. Handle, perform, resume — algebraic effect handlers compose freely without monad transformers.',
	},
	{
		id: 'types',
		title: 'Row-Polymorphic Types',
		status: 'Stable',
		icon: '<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
		body: 'Full Hindley-Milner type inference with row polymorphism for both records and effects. Pony-inspired reference capabilities (iso, trn, ref, val, box, tag) enforced at compile time.',
	},
	{
		id: 'otp',
		title: 'BEAM/OTP Primitives',
		status: 'Stable actor surface',
		icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
		body: 'Supervision trees (one_for_one, one_for_all, rest_for_one, simple_one_for_one), process groups, named registration, and exit trapping — battle-tested fault tolerance patterns.',
	},
	{
		id: 'wasm',
		title: 'WASM Backend',
		status: 'Experimental',
		icon: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>',
		body: 'Feature-gated MIR→WASM compilation with Wasmtime execution, SIMD support, and AOT artifacts. Treat compatibility and performance as experimental while the backend matures.',
	},
	{
		id: 'ai',
		title: 'AI Runtime',
		status: 'Experimental',
		icon: '<rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/>',
		body: 'Feature-gated provider integrations, agent pipelines, debate teams, supervisor hierarchies, and memory primitives. This is optional runtime functionality, not part of the frozen language core.',
	},
];
---

<div class="feature-grid" role="list" aria-label="Language features">
	{features.map((feature) => (
		<div class="feature-card" role="listitem">
			<div class="feature-icon-chip">
				<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" set:html={feature.icon} />
			</div>
			<div class="feature-heading">
				<h3>{feature.title}</h3>
				<span class="feature-status">{feature.status}</span>
			</div>
			<p>{feature.body}</p>
		</div>
	))}
</div>


<style>
	.feature-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1px;
		margin: 2.5rem 0 0;
		overflow: hidden;
		border: 1px solid var(--nu-border);
		border-radius: 1rem;
		background: var(--nu-border);
	}

	.feature-card {
		position: relative;
		display: flex;
		min-height: 18rem;
		flex-direction: column;
		padding: 1.6rem;
		border: 0;
		border-radius: 0;
		background: var(--nu-surface);
		box-shadow: none;
		transition: background 0.18s ease;
	}

	.feature-card::before {
		content: '';
		position: absolute;
		inset: 0 auto auto 0;
		width: 100%;
		height: 2px;
		background: var(--nu-blue);
		opacity: 0.82;
	}

	.feature-card:nth-child(n + 5)::before {
		background: var(--nu-accent-high);
		opacity: 0.7;
	}

	.feature-card:hover {
		transform: none;
		border-color: transparent;
		background: color-mix(in srgb, var(--nu-blue) 3.5%, var(--nu-surface));
		box-shadow: none;
	}

	.feature-icon-chip {
		width: 2.5rem;
		height: 2.5rem;
		margin-bottom: 1.5rem;
		border: 1px solid color-mix(in srgb, var(--nu-blue) 18%, var(--nu-border));
		border-radius: 0.55rem;
		background: color-mix(in srgb, var(--nu-blue) 6%, transparent);
	}

	.feature-card:nth-child(n + 5) .feature-icon-chip {
		border-color: color-mix(in srgb, var(--nu-accent-high) 18%, var(--nu-border));
		background: color-mix(in srgb, var(--nu-accent-high) 6%, transparent);
	}

	.feature-card:hover .feature-icon-chip {
		transform: none;
		background: color-mix(in srgb, var(--nu-blue) 9%, transparent);
	}

	.feature-card:nth-child(n + 5):hover .feature-icon-chip {
		background: color-mix(in srgb, var(--nu-accent-high) 9%, transparent);
	}

	.feature-card:hover .feature-icon {
		transform: none;
		color: var(--nu-blue);
	}

	.feature-card:nth-child(n + 5) .feature-icon,
	.feature-card:nth-child(n + 5):hover .feature-icon {
		color: var(--nu-accent-high);
	}

	.feature-heading {
		display: grid;
		gap: 0.55rem;
	}

	.feature-heading h3 {
		margin: 0;
		color: var(--nu-text);
		font-size: 1.05rem;
		letter-spacing: -0.015em;
	}

	.feature-status {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		min-height: 1.4rem;
		padding: 0.18rem 0.45rem;
		border: 1px solid color-mix(in srgb, var(--nu-blue) 20%, var(--nu-border));
		border-radius: 0.35rem;
		background: color-mix(in srgb, var(--nu-blue) 5%, transparent);
		color: var(--nu-blue);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.61rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: 0.025em;
	}

	.feature-card:nth-child(n + 5) .feature-status {
		border-color: color-mix(in srgb, var(--nu-accent-high) 22%, var(--nu-border));
		background: color-mix(in srgb, var(--nu-accent-high) 6%, transparent);
		color: var(--nu-accent-high);
	}

	.feature-card p {
		margin-top: auto;
		padding-top: 1.5rem;
		color: var(--nu-text-secondary);
		font-size: 0.86rem;
		line-height: 1.68;
	}

	@media (min-width: 40rem) {
		.feature-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.feature-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
