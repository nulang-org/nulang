---
const demoSource = String.raw`actor PoolWorker {
    state count: Int = 0
    behavior work(x) { self.count = self.count + x }
    behavior die() { perform Actor.exit(1) }
}

fn main() {
    let sup = perform Otp.create_supervisor("pool", 3)
    let t = perform Otp.set_template(sup, "PoolWorker")
    let w1 = perform Otp.start_child(sup)
    let w2 = perform Otp.start_child(sup)
    w1 ! work(1)
    w2 ! work(2)
    // Crash w1: the supervisor restarts it from the template, so its
    // count goes back to 0 with a fresh actor id. w2 keeps its count.
    w1 ! die()
    0
}`;
---

<section class="native-example" aria-labelledby="native-example-heading">
  <div class="native-example-copy">
    <span class="native-example-kicker">Native runtime · supervised actors</span>
    <h2 id="native-example-heading">See what happens when a worker fails.</h2>
    <p>
      An abnormal worker exit is handled by its supervisor. The other worker
      keeps running; a transient worker restarts with a new actor identity and default state.
    </p>
    <p class="native-example-boundary">
      This example runs with the installed Nulang CLI, not the browser CoreVM.
      Supervisor restart is not the same as recovering prior state: durable recovery is separate
      and requires a configured persistent store and application-level validation.
    </p>
    <div class="native-example-links">
      <a class="native-example-primary" href="/getting-started/installation/">Install Nulang <span aria-hidden="true">→</span></a>
      <a href="/actors/supervision/">How supervision works <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="native-example-code">
    <div class="native-example-bar">
      <span>examples/worker_pool.nula</span>
      <span>Source example · native only</span>
    </div>
    <pre tabindex="0" aria-label="Source code for the native supervised worker pool"><code>{demoSource}</code></pre>
    <div class="native-example-foot">
      <code>nulang examples/worker_pool.nula</code>
      <a href="https://github.com/nulang-org/nulang/blob/main/examples/worker_pool.nula" target="_blank" rel="noopener noreferrer">View source <span aria-hidden="true">↗</span><span class="native-example-sr"> (opens in new tab)</span></a>
