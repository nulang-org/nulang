import stdlib::web::unpoly
import stdlib::web::html
import stdlib::web::types

fn results() -> Html {
    el("main", [("id", text("results"))], [text("Results loaded")])
}

fn search() -> Html {
    if is_fragment() then {
        results()
    } else {
        document(
            head([title("Unpoly search")]),
            body([
                el("form", [
                    ("method", text("GET")),
                    ("action", text("/search")),
                    submit(),
                    target("#results")
                ], [
                    el("input", [("name", text("q"))], []),
                    el("button", [("type", text("submit"))], [text("Find")])
                ]),
                el("a", [
                    ("href", text("/search")),
                    follow(),
                    target("#results")
                ], [text("Load results")]),
                results()
            ])
        )
    }
}

app "unpoly-compat" {
    route "GET" "/search" -> search
}
