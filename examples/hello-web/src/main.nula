import stdlib::web::html
import stdlib::web::types

app "hello" {
    route "GET" "/" -> home
}

@placement(static)
fn home() -> Html {
    document(
        head([
            title("Hello Nulang Web"),
            el("link", [("rel", text("stylesheet")), ("href", text("/style.css"))], [])
        ]),
        body([
            el("h1", [], [text("Hello, Nulang Web!")]),
            el("p", [], [text("This page is generated by the compiler-first Nulang Web framework.")])
        ])
    )
}
