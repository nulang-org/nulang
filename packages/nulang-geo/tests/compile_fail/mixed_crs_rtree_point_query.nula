// Must fail: an R-tree point query must use the tree's CRS.
import lib

fn main() {
    let entries = [
        rtree_entry(
            bounding_box(0.0, 0.0, 1.0, 1.0, CARTESIAN),
            1
        )
    ];
    let tree = rtree_bulk_load_str(entries, CARTESIAN, 4);
    rtree_query_point(tree, wgs84(0.5, 0.5))
}
