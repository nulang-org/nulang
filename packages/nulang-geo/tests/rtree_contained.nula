import lib

fn main() {
    let entries = [
        rtree_entry(bounding_box(0.0, 0.0, 1.0, 1.0, CARTESIAN), 1),
        rtree_entry(bounding_box(2.0, 2.0, 3.0, 3.0, CARTESIAN), 4),
        rtree_entry(bounding_box(8.0, 8.0, 9.0, 9.0, CARTESIAN), 9)
    ];
    let tree = rtree_bulk_load_str(entries, CARTESIAN, 2);
    let hits = rtree_query_contained_by(
        tree,
        bounding_box(-0.5, -0.5, 3.5, 3.5, CARTESIAN)
    );
    perform Test.assert(
        perform Array.length(hits) == 2,
        "contained-by query should return fully enclosed entries"
    )
}
