#!/usr/bin/env sh
# Pre-commit: mirror the CI formatting and correctness contract without
# suppressing cargo's exit status when it emits no warning lines.
set -e

echo "→ cargo fmt --check"
cargo fmt --all -- --check

echo "→ cargo check --tests (zero warnings)"
check_output="$(cargo check --locked --tests 2>&1)" || {
    printf '%s\n' "$check_output" >&2
    exit 1
}
printf '%s\n' "$check_output"
if printf '%s\n' "$check_output" | grep -q 'warning:'; then
    echo "ERROR: compiler warnings found. Fix before committing." >&2
    exit 1
fi

echo "✓ pre-commit checks passed"
