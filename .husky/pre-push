#!/usr/bin/env sh
# Pre-push: use the same blocking Clippy policy as CI.
set -e

export PATH="$HOME/.cargo/bin:$PATH"

echo "→ cargo clippy --locked --all-targets -- -D clippy::correctness"
cargo clippy --locked --all-targets -- -D clippy::correctness

echo "→ cargo test --locked"
cargo test --locked

echo "✓ pre-push checks passed"
